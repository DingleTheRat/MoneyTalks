{
  "schemaVersion": 1,
  "id": "moneytalks",
  "version": "${version}",
  "name": "Money Talks",
  "description": "A client and server-side mod that adds money to the game. With enough coins, you can get some good stuff.",
  "authors": ["DingleTheRat"],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "All rigts reserved",
  "icon": "assets/moneytalks/textures/item/wallet.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.dingletherat.MoneyTalks"],
    "client": ["net.dingletherat.MoneyTalksClient"],
    "fabric-datagen": ["net.dingletherat.MoneyTalksDataGenerator"]
  },
  "mixins": [
    "moneytalks.mixins.json",
    {
      "config": "moneytalks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "26.1.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
